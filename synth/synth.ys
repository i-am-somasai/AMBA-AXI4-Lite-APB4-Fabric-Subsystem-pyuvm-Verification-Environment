# Yosys Synthesis Script for AMBA-Fabric Top on SKY130 HD
# Target: amba_fabric_top with RAM_DEPTH=64 (Spec Section 13.1 & 7.5)

# Read all RTL sources
read_verilog -sv rtl/common/rst_sync.v
read_verilog -sv rtl/common/sync_fifo.v
read_verilog -sv rtl/common/async_fifo.v
read_verilog -sv rtl/common/rr_arbiter.v
read_verilog -sv rtl/axil/axil_decoder.v
read_verilog -sv rtl/axil/axil_default_slave.v
read_verilog -sv rtl/axil/axil_xbar.v
read_verilog -sv rtl/axil/axil_ram.v
read_verilog -sv rtl/axil/axil_csr.v
read_verilog -sv rtl/apb/axil2apb_bridge.v
read_verilog -sv rtl/apb/apb_decoder.v
read_verilog -sv rtl/apb/apb_uart.v
read_verilog -sv rtl/apb/apb_timer.v
read_verilog -sv rtl/apb/apb_gpio.v
read_verilog -sv rtl/cdc/slow_regs.v
read_verilog -sv rtl/cdc/axil_cdc_bridge.v
read_verilog -sv rtl/amba_fabric_top.v

# Elaborate hierarchy with RAM_DEPTH=64 to avoid flop bloat
hierarchy -top amba_fabric_top -chparam RAM_DEPTH 64

# Synthesis flow: flatten for global logic optimization
synth -top amba_fabric_top -flatten

# Technology mapping to SKY130 HD library
dfflibmap -liberty /home/somasai/.volare/volare/sky130/versions/0fe599b2afb6708d281543108caf8310912f54af/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty /home/somasai/.volare/volare/sky130/versions/0fe599b2afb6708d281543108caf8310912f54af/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -D 10000

# Cleanup unused logic
opt_clean -purge

# Area and cell statistics mapped to SKY130 HD
stat -liberty /home/somasai/.volare/volare/sky130/versions/0fe599b2afb6708d281543108caf8310912f54af/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# Output gate-level netlist
write_verilog -noattr synth/results/amba_fabric_netlist.v
