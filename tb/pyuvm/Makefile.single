# Single test runner for pyuvm testbenches
SIM ?= icarus
TOPLEVEL_LANG ?= verilog
PROJ_DIR ?= $(abspath ../..)
BUILD_DIR ?= $(PROJ_DIR)/build
SIM_BUILD ?= $(BUILD_DIR)/sim_build/pyuvm_$(TOPLEVEL)
COCOTB_RESULTS_FILE ?= $(BUILD_DIR)/results/pyuvm/results_$(MODULE).xml

$(shell mkdir -p $(dir $(SIM_BUILD)) $(dir $(COCOTB_RESULTS_FILE)) $(BUILD_DIR)/tmp)
export TMPDIR := $(BUILD_DIR)/tmp

ifdef SEED
export COCOTB_RANDOM_SEED := $(SEED)
export RANDOM_SEED := $(SEED)
endif

ifeq ($(SIM),icarus)
COMPILE_ARGS += -g2012 -DCOCOTB_SIM
endif

ifeq ($(SIM),verilator)
EXTRA_ARGS += -DCOCOTB_SIM --trace
ifeq ($(VERILATOR_COVERAGE),1)
EXTRA_ARGS += --coverage
endif
endif

# Export PYTHONPATH so pyuvm finds tb/models, tb/pyuvm, and test files
export PYTHONPATH := $(PROJ_DIR)/tb:$(PROJ_DIR)/tb/pyuvm:$(PROJ_DIR)/tb/pyuvm/tests:$(PYTHONPATH)

# Include standard cocotb Makefile
include $(shell cocotb-config --makefiles)/Makefile.sim
