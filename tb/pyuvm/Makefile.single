# Single test runner for pyuvm testbenches
SIM ?= icarus
TOPLEVEL_LANG ?= verilog
SIM_BUILD ?= sim_build_$(TOPLEVEL)
PROJ_DIR ?= $(abspath ../..)
COCOTB_RESULTS_FILE ?= results_$(MODULE).xml

ifeq ($(SIM),icarus)
COMPILE_ARGS += -g2012 -DCOCOTB_SIM
endif

ifeq ($(SIM),verilator)
EXTRA_ARGS += -DCOCOTB_SIM --trace
ifeq ($(VERILATOR_COVERAGE),1)
EXTRA_ARGS += --coverage
endif
endif

# Export PYTHONPATH so pyuvm finds tb/models, tb/pyuvm, and test files
export PYTHONPATH := $(PROJ_DIR)/tb:$(PROJ_DIR)/tb/pyuvm:$(PROJ_DIR)/tb/pyuvm/tests:$(PYTHONPATH)

# Include standard cocotb Makefile
include $(shell cocotb-config --makefiles)/Makefile.sim
