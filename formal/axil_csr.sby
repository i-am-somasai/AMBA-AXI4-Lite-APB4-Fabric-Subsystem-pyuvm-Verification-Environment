[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 20
bmc: mode bmc
bmc: depth 20
cover: mode cover
cover: depth 20

[engines]
smtbmc boolector

[script]
read -formal -sv -DFORMAL axil_props.v
prove: read -formal -sv -DFORMAL axil_csr.v
bmc: read -formal -sv -DFORMAL -DFORMAL_CAUSALITY axil_csr.v
cover: read -formal -sv -DFORMAL -DFORMAL_CAUSALITY axil_csr.v
prep -top axil_csr

[files]
axil_props.v
../rtl/axil/axil_csr.v
