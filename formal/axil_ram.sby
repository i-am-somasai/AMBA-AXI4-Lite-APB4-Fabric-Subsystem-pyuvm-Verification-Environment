[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 20
cover: mode cover
cover: depth 20

[engines]
smtbmc boolector

[script]
read -formal -sv -DFORMAL axil_props.v
read -formal -sv -DFORMAL axil_ram.v
chparam -set RAM_DEPTH 16 axil_ram
prep -top axil_ram

[files]
axil_props.v
../rtl/axil/axil_ram.v
